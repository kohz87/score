# Score as a systemd *user* service. Documented, not installed by Score (see docs/SETUP.md section 9).
#
#   mkdir -p ~/.config/systemd/user
#   cp docs/score.service.example ~/.config/systemd/user/score.service
#   $EDITOR ~/.config/systemd/user/score.service     # fix WorkingDirectory and the node path
#   systemctl --user daemon-reload
#   systemctl --user enable --now score
#   journalctl --user -u score -f                    # the first pairing link is printed here
#   loginctl enable-linger "$USER"                   # optional: keep it running when you are logged out
[Unit]
Description=Score (Hermes team workspace)
After=network.target

[Service]
Type=simple
# Absolute path to your clone, after `pnpm build`.
WorkingDirectory=%h/score
# Run node directly: systemd does not read your shell profile, so use the absolute path from `command -v node`.
ExecStart=/usr/bin/env node scripts/start.mjs
Environment=SCORE_HOME=%h/.score
Environment=SCORE_PORT=8740
Environment=SCORE_MODE=live
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=default.target
