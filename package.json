{
  "name": "score",
  "version": "3.14.1",
  "private": true,
  "description": "A multi-agent workspace for Hermes Agent",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @score/server --filter @score/web dev",
    "build": "pnpm -r build && pnpm typecheck",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "screenshots": "playwright test -c e2e/readme/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "license:check": "node scripts/license-check.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:plugin && pnpm license:check",
    "test:plugin": "cd hermes-plugin && uv run --offline pytest -q",
    "load-test": "pnpm --filter @score/server exec tsx ../../scripts/load-test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
