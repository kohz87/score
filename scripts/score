#!/usr/bin/env bash
# Score launcher: score start|stop|status|logs|pair|password|look|tls. State lives in $SCORE_HOME (default ~/.score).
set -euo pipefail

script="$(readlink -f "${BASH_SOURCE[0]}")"
root="$(dirname "$(dirname "$script")")"
home="${SCORE_HOME:-$HOME/.score}"
# The launcher changes directory; a relative home would then name a different place.
mkdir -p "$home"
home="$(cd "$home" && pwd -P)"
pid_file="$home/score.pid"
log_file="$home/score.log"
# The browser address the running server printed (remote mode serves the browser on another host and port).
url_file="$home/score.url"
pair_file="$home/pair-link"
port="${SCORE_PORT:-8740}"
host="${SCORE_HOST:-127.0.0.1}"

usage() {
  echo "Usage: score start|stop|status|logs [-f]|pair|password|look reset|restore <backup>|installation status|confirm-move|confirm-copy|reset-history|tls [--new-ca]|tailscale" >&2
  exit 2
}

# Prints the PID when the recorded process is a live Score server (guards against PID reuse).
running_pid() {
  local pid
  [[ -f "$pid_file" ]] || return 1
  pid="$(<"$pid_file")"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 'scripts/start.mjs' || return 1
  echo "$pid"
}

# Start and stop take turns: two at once would overwrite each other's PID file.
lock_launcher() {
  exec 9>"$home/score.launcher.lock"
  flock 9
}

# Remote mode is HTTPS-only. Without SCORE_TLS_CERT/KEY, use the certificate `score tls` made, if there is one, and
# make the public origins https:// (derived from SCORE_HOST and the port when SCORE_PUBLIC_ORIGINS is unset).
use_local_tls() {
  [[ "${SCORE_REMOTE:-}" == "1" ]] || return 0
  [[ -z "${SCORE_TLS_CERT:-}" && -z "${SCORE_TLS_KEY:-}" ]] || return 0
  [[ -r "$home/tls/server.crt" && -r "$home/tls/server.key" ]] || return 0
  export SCORE_TLS_CERT="$home/tls/server.crt" SCORE_TLS_KEY="$home/tls/server.key"
  if [[ -n "${SCORE_PUBLIC_ORIGINS:-}" ]]; then
    export SCORE_PUBLIC_ORIGINS="${SCORE_PUBLIC_ORIGINS//http:\/\//https://}"
  elif [[ -n "${SCORE_HOST:-}" && "$SCORE_HOST" != "0.0.0.0" && "$SCORE_HOST" != "::" ]]; then
    if [[ "$SCORE_HOST" == *:* ]]; then
      export SCORE_PUBLIC_ORIGINS="https://[$SCORE_HOST]:${SCORE_PORT:-8741}"
    else
      export SCORE_PUBLIC_ORIGINS="https://$SCORE_HOST:${SCORE_PORT:-8741}"
    fi
  fi
}

# Named certificates (5.22): `<name>.crt` + `<name>.key` in $SCORE_HOME/tls/tailscale (see `score tailscale`). Score
# serves each to browsers that ask for that name, and each name becomes a public origin.
use_named_tls() {
  [[ "${SCORE_REMOTE:-}" == "1" && -n "${SCORE_TLS_CERT:-}" && -z "${SCORE_TLS_NAMES_DIR:-}" ]] || return 0
  local dir="$home/tls/tailscale" crt name origins="${SCORE_PUBLIC_ORIGINS:-}" found=0
  [[ -d "$dir" ]] || return 0
  for crt in "$dir"/*.crt; do
    [[ -f "$crt" ]] || continue
    name="$(basename "$crt" .crt)"
    [[ -f "$dir/$name.key" && "$name" =~ ^[a-z0-9.-]+$ ]] || continue
    found=1
    [[ ",$origins," == *",https://$name:${SCORE_PORT:-8741},"* ]] && continue
    origins="${origins:+$origins,}https://$name:${SCORE_PORT:-8741}"
  done
  # Usable certificates enable the directory even when every name is already listed as an origin.
  [[ "$found" == 1 ]] || return 0
  export SCORE_TLS_NAMES_DIR="$dir"
  [[ "$origins" == "${SCORE_PUBLIC_ORIGINS:-}" ]] || export SCORE_PUBLIC_ORIGINS="$origins"
}

cmd_start() {
  local pid offset i child
  lock_launcher
  if pid="$(running_pid)"; then
    echo "Score is already running (pid $pid). Use 'score pair' for a new pairing link."
    return 0
  fi
  if [[ ! -f "$root/apps/web/dist/index.html" ]]; then
    echo "Score is not built yet. Run 'pnpm build' in $root first." >&2
    return 1
  fi
  mkdir -p "$home"
  use_local_tls
  use_named_tls
  # Keep the log bounded: past 10 MB the previous log becomes score.log.1 (one generation; the server only appends).
  if [[ -f "$log_file" && "$(wc -c <"$log_file")" -gt 10485760 ]]; then
    mv -f "$log_file" "$log_file.1"
  fi
  touch "$log_file"
  offset="$(wc -c <"$log_file")"
  (
    cd "$root"
    # 9>&- keeps the launcher lock from being inherited by the long-running server.
    SCORE_HOME="$home" SCORE_LOG_FILE="$log_file" SCORE_SERVE_WEB=1 nohup node scripts/start.mjs >>"$log_file" 2>&1 </dev/null 9>&- &
    echo $! >"$pid_file"
  )
  child="$(<"$pid_file")"
  for ((i = 0; i < 100; i++)); do
    # Only a dead process is a failure here: right after the fork its cmdline is still nohup's, so
    # running_pid's start.mjs check could misreport a healthy start under load.
    if ! kill -0 "$child" 2>/dev/null; then
      echo "Score failed to start:" >&2
      tail -n 20 "$log_file" >&2
      [[ "$(cat "$pid_file" 2>/dev/null)" == "$child" ]] && rm -f "$pid_file"
      return 1
    fi
    if tail -c +"$((offset + 1))" "$log_file" | grep -Eq 'Pair this browser|Setup guide:'; then
      # Before any output: a caller reading only the first line (| head -1) would stop us mid-way.
      tail -c +"$((offset + 1))" "$log_file" | grep -Em1 'Pair this browser|Setup guide:' |
        sed -E 's#^.*(Pair this browser|Setup guide): (https?://[^/]+)/.*#\2#' >"$url_file" || true
      echo "Score started (pid $(running_pid)). Log: $log_file"
      tail -c +"$((offset + 1))" "$log_file" | grep -E 'Pair this browser|Setup guide:|Run scripts/score tls' | head -n 2
      # The link itself never goes to score.log: the server leaves it in a 0600 file, shown once here.
      if [[ -f "$pair_file" ]]; then
        echo "Pair this browser: $(<"$pair_file")"
        rm -f "$pair_file"
      fi
      return 0
    fi
    sleep 0.2
  done
  echo "Score did not report ready within 20s; see $log_file" >&2
  return 1
}

cmd_stop() {
  local pid i
  lock_launcher
  if ! pid="$(running_pid)"; then
    rm -f "$pid_file"
    echo "Score is not running."
    return 0
  fi
  kill -TERM "$pid"
  # A clean stop drains in-flight Hermes reads, task tailing and the approval outbox first (~17 s seen live).
  for ((i = 0; i < 450; i++)); do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$pid_file"
      echo "Score stopped."
      return 0
    fi
    sleep 0.1
  done
  echo "Score (pid $pid) did not exit within 45s." >&2
  return 1
}

cmd_status() {
  local pid
  if pid="$(running_pid)"; then
    if [[ -s "$url_file" ]]; then
      echo "Score is running (pid $pid). Open $(<"$url_file") in your browser."
    else
      echo "Score is running (pid $pid) at http://$host:$port"
    fi
  else
    echo "Score is not running."
    return 1
  fi
}

cmd_logs() {
  [[ -f "$log_file" ]] || { echo "No log yet: $log_file" >&2; return 1; }
  if [[ "${1:-}" == "-f" ]]; then tail -n 100 -f "$log_file"; else tail -n 100 "$log_file"; fi
}

cmd_pair() {
  local pid i
  if ! pid="$(running_pid)"; then
    echo "Score is not running. Start it with 'score start'." >&2
    return 1
  fi
  rm -f "$pair_file"
  kill -USR2 "$pid"
  for ((i = 0; i < 50; i++)); do
    if [[ -f "$pair_file" ]]; then
      echo "Pair this browser: $(<"$pair_file")"
      rm -f "$pair_file"
      return 0
    fi
    sleep 0.1
  done
  if grep -E 'Pair this browser|Setup guide:' "$log_file" | tail -n 1 | grep -q 'Setup guide:'; then
    echo "Score is only serving the HTTPS setup guide: finish HTTPS setup (scripts/score tls) and restart, then pair." >&2
    return 1
  fi
  echo "Score did not produce a pairing link; see $log_file" >&2
  return 1
}

# Tailscale certificate (Let's Encrypt, for this machine's ts.net name) into $SCORE_HOME/tls/tailscale. Needs Tailscale
# with MagicDNS and HTTPS certificates on, and `sudo tailscale set --operator=$USER` once. Score renews it daily.
cmd_tailscale() {
  command -v tailscale >/dev/null || { echo "Tailscale is not installed." >&2; return 1; }
  local name dir="$home/tls/tailscale"
  name="$(tailscale status --json | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))')"
  [[ "$name" =~ ^[a-z0-9.-]+\.ts\.net$ ]] || { echo "No ts.net name: turn on MagicDNS in the Tailscale admin console." >&2; return 1; }
  umask 077
  mkdir -p "$dir"
  chmod 700 "$dir"
  tailscale cert --cert-file "$dir/$name.crt" --key-file "$dir/$name.key" "$name"
  chmod 600 "$dir/$name.key"
  chmod 644 "$dir/$name.crt"
  echo "Certificate for $name in $dir. Restart Score (it must listen on the Tailscale address too, e.g."
  echo "SCORE_HOST=0.0.0.0 SCORE_REMOTE_ANY=1) and open https://$name:${SCORE_PORT:-8741}/"
}

# Local certificate authority and server certificate for remote (HTTPS-only) mode, kept in $SCORE_HOME/tls.
cmd_tls() {
  local new_ca=0 tls_dir="$home/tls" host_name safe_name san="" entry item ext_file csr
  local -a names=() sans=()
  case "${1:-}" in
    "") ;;
    --new-ca) new_ca=1 ;;
    *) usage ;;
  esac
  command -v openssl >/dev/null || { echo "openssl is required (install the openssl package)." >&2; return 1; }
  umask 077
  mkdir -p "$tls_dir"
  chmod 700 "$tls_dir"
  host_name="$(hostname 2>/dev/null || echo score)"
  safe_name="$(printf '%s' "$host_name" | tr -c 'A-Za-z0-9.-' '-')"

  # Subject alternative names: SCORE_HOST, the hosts of SCORE_PUBLIC_ORIGINS, localhost and 127.0.0.1. Only characters
  # that can occur in a host name or an IP address are accepted; anything else is skipped with a note.
  add_san() {
    local value="$1" kind
    value="${value#[}"
    value="${value%]}"
    [[ -n "$value" && "$value" != "0.0.0.0" && "$value" != "::" ]] || return 0
    if [[ ! "$value" =~ ^[A-Za-z0-9.:-]+$ ]]; then
      echo "Skipping unusable host name: $value" >&2
      return 0
    fi
    if [[ "$value" =~ ^[0-9.]+$ || "$value" == *:* ]]; then kind="IP"; else kind="DNS"; fi
    for item in "${sans[@]:-}"; do [[ "$item" == "$kind:$value" ]] && return 0; done
    sans+=("$kind:$value")
  }
  add_san "${SCORE_HOST:-}"
  IFS=',' read -r -a names <<<"${SCORE_PUBLIC_ORIGINS:-}"
  for entry in "${names[@]:-}"; do
    entry="${entry//[[:space:]]/}"
    entry="${entry#*://}"
    entry="${entry%%/*}"
    if [[ "$entry" == \[* ]]; then entry="${entry%%]*}"; else entry="${entry%%:*}"; fi
    add_san "$entry"
  done
  add_san localhost
  add_san 127.0.0.1
  for item in "${sans[@]}"; do san+="${san:+,}$item"; done

  if [[ "$new_ca" == 1 || ! -f "$tls_dir/ca.key" || ! -f "$tls_dir/ca.crt" ]]; then
    rm -f "$tls_dir/ca.key" "$tls_dir/ca.crt" "$tls_dir/ca.srl"
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -sha256 -days 3650 \
      -keyout "$tls_dir/ca.key" -out "$tls_dir/ca.crt" \
      -subj "/CN=Score local CA ($safe_name)" \
      -addext "basicConstraints=critical,CA:TRUE" \
      -addext "keyUsage=critical,keyCertSign,cRLSign" \
      -addext "subjectKeyIdentifier=hash" 2>/dev/null
    echo "Created a new certificate authority."
  else
    echo "Keeping the existing certificate authority (use --new-ca to replace it)."
  fi
  chmod 600 "$tls_dir/ca.key"

  ext_file="$(mktemp "$tls_dir/ext.XXXXXX")"
  csr="$(mktemp "$tls_dir/csr.XXXXXX")"
  printf '%s\n' "basicConstraints=critical,CA:FALSE" "keyUsage=critical,digitalSignature" \
    "extendedKeyUsage=serverAuth" "subjectAltName=$san" "subjectKeyIdentifier=hash" \
    "authorityKeyIdentifier=keyid" >"$ext_file"
  openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -sha256 \
    -keyout "$tls_dir/server.key" -out "$csr" -subj "/CN=$safe_name" 2>/dev/null
  openssl x509 -req -in "$csr" -CA "$tls_dir/ca.crt" -CAkey "$tls_dir/ca.key" -CAcreateserial \
    -days 825 -sha256 -extfile "$ext_file" -out "$tls_dir/server.crt" 2>/dev/null
  rm -f "$ext_file" "$csr"
  chmod 600 "$tls_dir/server.key"
  chmod 644 "$tls_dir/server.crt" "$tls_dir/ca.crt"

  cat <<EOT
Certificate files in $tls_dir:
  ca.crt       the certificate authority to install on each device (public)
  ca.key       its private key: keep it on this machine only
  server.crt   Score's certificate for: $san
  server.key   its private key

Next steps:
  1. Install ca.crt on every device that opens Score (the setup guide at /setup/https has the steps per platform).
  2. Start Score with SCORE_REMOTE=1 SCORE_HOST=<this machine's address> scripts/score start (restart it if it is
     running). It uses these files automatically and serves https://<address>:8741/.
EOT
}

case "${1:-}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  logs) shift; cmd_logs "${1:-}" ;;
  pair) cmd_pair ;;
  # Sets or resets the security password that guards pairing management (a forgotten one is reset only here).
  tls) shift; cmd_tls "${1:-}" ;;
  tailscale) cmd_tailscale ;;
  password) SCORE_HOME="$home" exec node "$root/scripts/set-password.mjs" ;;
  # 9.1: the way back to the default look if a theme makes Score hard to use (works with Score stopped).
  look) shift; SCORE_HOME="$home" exec node "$root/scripts/look.mjs" "$@" ;;
  # The only supported way to restore the home (7.5): sets the global admission fence for the next start.
  restore) shift; SCORE_HOME="$home" exec node "$root/scripts/restore.mjs" "$@" ;;
  # 7.7a: tell Score a home at a new path is a moved folder (confirm-move) or a copy (confirm-copy); reset-history starts a
  # new run history when Score is holding all agent work (a copied home, a lost journal).
  installation) shift; SCORE_HOME="$home" exec node "$root/scripts/installation.mjs" "$@" ;;
  *) usage ;;
esac
