#!/usr/bin/env bash
# Score launcher: score start|stop|restart|status|run|service|logs|pair|password|look|tls. State lives in $SCORE_HOME (default ~/.score).
set -euo pipefail

script="$(readlink -f "${BASH_SOURCE[0]}")"
root="$(dirname "$(dirname "$script")")"
# An installed service (PLAN 10.13) keeps its home in its env file: a fresh shell without SCORE_HOME follows it, so
# restart, pair and logs read the service's files. The file is read as text, never sourced.
saved_service_home() {
  local env="${SCORE_CONFIG_DIR:-$HOME/.config/score}/score.env" line
  [[ -f "${SCORE_SYSTEMD_USER_DIR:-$HOME/.config/systemd/user}/score.service" && -f "$env" ]] || return 1
  line="$(grep -m1 '^SCORE_HOME="' "$env")" || return 1
  line="${line#SCORE_HOME=\"}"
  line="${line%\"}"
  line="${line//\\\"/\"}"
  line="${line//\\\\/\\}"
  [[ -n "$line" ]] && printf '%s' "$line"
}
if [[ -z "${SCORE_HOME:-}" ]] && saved="$(saved_service_home)"; then
  home="$saved"
else
  home="${SCORE_HOME:-$HOME/.score}"
fi
# The launcher changes directory; a relative home would then name a different place.
mkdir -p "$home"
home="$(cd "$home" && pwd -P)"
pid_file="$home/score.pid"
log_file="$home/score.log"
# The browser address the running server printed (remote mode serves the browser on another host and port).
url_file="$home/score.url"
pair_file="$home/pair-link"
port="${SCORE_PORT:-8740}"
host="${SCORE_HOST:-127.0.0.1}"

usage() {
  echo "Usage: score start|stop|restart|status|run|service install|status|uninstall [--purge]|logs [-f]|pair|password|look reset|restore <backup>|installation status|confirm-move|confirm-copy|reset-history|tls [--new-ca]|tailscale" >&2
  exit 2
}

# Prints the PID when the recorded process is a live Score server (guards against PID reuse).
running_pid() {
  local pid
  [[ -f "$pid_file" ]] || return 1
  pid="$(<"$pid_file")"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 'scripts/start.mjs' || return 1
  echo "$pid"
}

# Start and stop take turns: two at once would overwrite each other's PID file.
lock_launcher() {
  exec 9>"$home/score.launcher.lock"
  flock 9
}

# One server per home, for its whole life: a separate lock on fd 8 that survives `exec node` (the launcher lock is
# released first, and the pid file alone can't tell a process that is about to exec). Node closes it for its children.
lock_instance() {
  exec 8>"$home/score.instance.lock"
  flock -n 8
}

# Remote mode is HTTPS-only. Without SCORE_TLS_CERT/KEY, use the certificate `score tls` made, if there is one, and
# make the public origins https:// (derived from SCORE_HOST and the port when SCORE_PUBLIC_ORIGINS is unset).
use_local_tls() {
  [[ "${SCORE_REMOTE:-}" == "1" ]] || return 0
  [[ -z "${SCORE_TLS_CERT:-}" && -z "${SCORE_TLS_KEY:-}" ]] || return 0
  [[ -r "$home/tls/server.crt" && -r "$home/tls/server.key" ]] || return 0
  export SCORE_TLS_CERT="$home/tls/server.crt" SCORE_TLS_KEY="$home/tls/server.key"
  if [[ -n "${SCORE_PUBLIC_ORIGINS:-}" ]]; then
    export SCORE_PUBLIC_ORIGINS="${SCORE_PUBLIC_ORIGINS//http:\/\//https://}"
  elif [[ -n "${SCORE_HOST:-}" && "$SCORE_HOST" != "0.0.0.0" && "$SCORE_HOST" != "::" ]]; then
    if [[ "$SCORE_HOST" == *:* ]]; then
      export SCORE_PUBLIC_ORIGINS="https://[$SCORE_HOST]:${SCORE_PORT:-8741}"
    else
      export SCORE_PUBLIC_ORIGINS="https://$SCORE_HOST:${SCORE_PORT:-8741}"
    fi
  fi
}

# Named certificates (5.22): `<name>.crt` + `<name>.key` in $SCORE_HOME/tls/tailscale (see `score tailscale`). Score
# serves each to browsers that ask for that name, and each name becomes a public origin.
use_named_tls() {
  [[ "${SCORE_REMOTE:-}" == "1" && -n "${SCORE_TLS_CERT:-}" && -z "${SCORE_TLS_NAMES_DIR:-}" ]] || return 0
  local dir="$home/tls/tailscale" crt name origins="${SCORE_PUBLIC_ORIGINS:-}" found=0
  [[ -d "$dir" ]] || return 0
  for crt in "$dir"/*.crt; do
    [[ -f "$crt" ]] || continue
    name="$(basename "$crt" .crt)"
    [[ -f "$dir/$name.key" && "$name" =~ ^[a-z0-9.-]+$ ]] || continue
    found=1
    [[ ",$origins," == *",https://$name:${SCORE_PORT:-8741},"* ]] && continue
    origins="${origins:+$origins,}https://$name:${SCORE_PORT:-8741}"
  done
  # Usable certificates enable the directory even when every name is already listed as an origin.
  [[ "$found" == 1 ]] || return 0
  export SCORE_TLS_NAMES_DIR="$dir"
  [[ "$origins" == "${SCORE_PUBLIC_ORIGINS:-}" ]] || export SCORE_PUBLIC_ORIGINS="$origins"
}

# --- systemd user service (10.13) -------------------------------------------------------------------------------
# The overrides exist for tests (fake systemctl/loginctl and temp folders); normal use never sets them.
unit_dir="${SCORE_SYSTEMD_USER_DIR:-$HOME/.config/systemd/user}"
unit_file="$unit_dir/score.service"
config_dir="${SCORE_CONFIG_DIR:-$HOME/.config/score}"
env_file="$config_dir/score.env"
systemctl_bin="${SCORE_SYSTEMCTL:-systemctl}"
loginctl_bin="${SCORE_LOGINCTL:-loginctl}"
this_user="${USER:-$(id -un)}"

sc() { "$systemctl_bin" --user "$@"; }
service_installed() { [[ -f "$unit_file" ]]; }
service_active() { sc is-active --quiet score 2>/dev/null; }
service_pid() {
  local value
  value="$(sc show --property=MainPID --value score 2>/dev/null || true)"
  [[ "$value" =~ ^[1-9][0-9]*$ ]] && echo "$value"
  return 0
}

# A launcher-started Score (not the service's own process) that is still running on this home.
stray_pid() {
  local pid main
  pid="$(running_pid)" || return 1
  main=""
  if service_installed; then main="$(service_pid)"; fi
  [[ "$pid" != "$main" ]] || return 1
  echo "$pid"
}

# Shared by `start` and `run`: everything that has to be true before the server process begins.
prepare_run() {
  if [[ ! -f "$root/apps/web/dist/index.html" ]]; then
    echo "Score is not built yet. Run 'pnpm build' in $root first." >&2
    return 1
  fi
  mkdir -p "$home"
  use_local_tls
  use_named_tls
  # Keep the log bounded: past 10 MB the previous log becomes score.log.1 (one generation; the server only appends).
  if [[ -f "$log_file" && "$(wc -c <"$log_file")" -gt 10485760 ]]; then
    mv -f "$log_file" "$log_file.1"
  fi
  touch "$log_file"
}

log_state() { stat -c '%i %s' "$log_file" 2>/dev/null || echo "0 0"; }

# Waits for the server's ready line after $2 bytes of the log. $1 is a pid (launcher start) or "service".
wait_ready() {
  local who="$1" offset="$2" ino="$3" i dead cur_ino cur_size
  for ((i = 0; i < 100; i++)); do
    # The server (run) may rotate the log after the caller marked it: a new file or a shorter one is read from the start.
    read -r cur_ino cur_size < <(log_state)
    if [[ "$cur_ino" != "$ino" || "$cur_size" -lt "$offset" ]]; then offset=0; ino="$cur_ino"; fi
    dead=0
    # Only a dead process is a failure here: right after the fork its cmdline is still nohup's, so
    # running_pid's start.mjs check could misreport a healthy start under load.
    if [[ "$who" == service ]]; then
      if sc is-failed --quiet score 2>/dev/null; then dead=1; fi
    elif ! kill -0 "$who" 2>/dev/null; then
      dead=1
    fi
    if [[ "$dead" == 1 ]]; then
      echo "Score failed to start:" >&2
      tail -n 20 "$log_file" >&2
      [[ "$who" == service ]] || { [[ "$(cat "$pid_file" 2>/dev/null)" == "$who" ]] && rm -f "$pid_file"; }
      return 1
    fi
    if tail -c +"$((offset + 1))" "$log_file" | grep -Eq 'Pair this browser|Setup guide:'; then
      # Before any output: a caller reading only the first line (| head -1) would stop us mid-way.
      tail -c +"$((offset + 1))" "$log_file" | grep -Em1 'Pair this browser|Setup guide:' |
        sed -E 's#^.*(Pair this browser|Setup guide): (https?://[^/]+)/.*#\2#' >"$url_file" || true
      echo "Score started (pid $(running_pid || true)). Log: $log_file"
      tail -c +"$((offset + 1))" "$log_file" | grep -E 'Pair this browser|Setup guide:|Run scripts/score tls' | head -n 2
      # The link itself never goes to score.log: the server leaves it in a 0600 file, shown once here.
      if [[ -f "$pair_file" ]]; then
        echo "Pair this browser: $(<"$pair_file")"
        rm -f "$pair_file"
      fi
      return 0
    fi
    sleep 0.2
  done
  echo "Score did not report ready within 20s; see $log_file" >&2
  return 1
}

launcher_start() {
  local pid offset ino child
  lock_launcher
  if pid="$(running_pid)"; then
    echo "Score is already running (pid $pid). Use 'score pair' for a new pairing link."
    return 0
  fi
  if ! lock_instance; then
    echo "Another Score is starting or running on this home; not starting a second copy." >&2
    return 1
  fi
  prepare_run || return 1
  read -r ino offset < <(log_state)
  (
    cd "$root"
    # 9>&- keeps the launcher lock from being inherited by the long-running server.
    SCORE_HOME="$home" SCORE_LOG_FILE="$log_file" SCORE_SERVE_WEB=1 nohup node scripts/start.mjs >>"$log_file" 2>&1 </dev/null 9>&- &
    echo $! >"$pid_file"
  )
  child="$(<"$pid_file")"
  wait_ready "$child" "$offset" "$ino"
}

# `start` and `restart` once the unit is installed. No launcher lock here: `run` takes it while systemd starts us.
service_start() {
  local verb="$1" pid offset ino
  if pid="$(stray_pid)"; then
    echo "A Score started by the launcher is already running (pid $pid), so the service can't run beside it." >&2
    echo "Run 'scripts/score stop' first (the launcher stops that copy), then start the service." >&2
    return 1
  fi
  if [[ "$verb" == start ]] && service_active; then
    echo "Score is already running as a service (pid $(service_pid || true)). Use 'score pair' for a new pairing link."
    return 0
  fi
  mkdir -p "$home"
  touch "$log_file"
  read -r ino offset < <(log_state)
  # A manual start comes after the person fixed whatever crashed it: clear systemd's start limit (5 in 300 s) first.
  sc reset-failed score >/dev/null 2>&1 || true
  sc "$verb" score || { echo "systemctl --user $verb score failed." >&2; return 1; }
  wait_ready service "$offset" "$ino"
}

cmd_start() {
  if service_installed; then service_start start; else launcher_start; fi
}

cmd_restart() {
  if service_installed; then
    service_start restart
  else
    cmd_stop
    launcher_start
  fi
}

# Foreground start for systemd (and for anyone who wants Score in a terminal): the process becomes the server.
cmd_run() {
  local pid
  lock_launcher
  if pid="$(running_pid)"; then
    echo "Score is already running on this home (pid $pid); not starting a second copy." >&2
    return 1
  fi
  if ! lock_instance; then
    echo "Another Score is starting or running on this home; not starting a second copy." >&2
    return 1
  fi
  prepare_run || return 1
  echo $$ >"$pid_file"
  # Release the lock and, under systemd, follow the log by name so a rotation above is not lost.
  exec 9>&-
  [[ -t 1 ]] || exec >>"$log_file" 2>&1
  cd "$root"
  SCORE_HOME="$home" SCORE_LOG_FILE="$log_file" SCORE_SERVE_WEB=1 exec node scripts/start.mjs
}

launcher_stop() {
  local pid i
  lock_launcher
  if ! pid="$(running_pid)"; then
    rm -f "$pid_file"
    echo "Score is not running."
    return 0
  fi
  kill -TERM "$pid"
  # A clean stop drains in-flight Hermes reads, task tailing and the approval outbox first (~17 s seen live).
  for ((i = 0; i < 450; i++)); do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$pid_file"
      echo "Score stopped."
      return 0
    fi
    sleep 0.1
  done
  echo "Score (pid $pid) did not exit within 45s." >&2
  return 1
}

cmd_stop() {
  if ! service_installed; then
    launcher_stop
    return
  fi
  # Blocks until the unit is down (it drains for up to ~45 s); a stray launcher copy is stopped too.
  sc stop score || { echo "systemctl --user stop score failed." >&2; return 1; }
  running_pid >/dev/null || rm -f "$pid_file"
  if stray_pid >/dev/null; then launcher_stop; else echo "Score stopped."; fi
}

cmd_status() {
  local pid
  if service_installed; then
    if service_active; then
      pid="$(service_pid || true)"
      if [[ -s "$url_file" ]]; then
        echo "Score is running as a service (pid ${pid:-?}). Open $(<"$url_file") in your browser."
      else
        echo "Score is running as a service (pid ${pid:-?}) at http://$host:$port"
      fi
    else
      echo "Score is installed as a service but is not running (systemctl --user status score)."
      return 1
    fi
    return 0
  fi
  if pid="$(running_pid)"; then
    if [[ -s "$url_file" ]]; then
      echo "Score is running (pid $pid). Open $(<"$url_file") in your browser."
    else
      echo "Score is running (pid $pid) at http://$host:$port"
    fi
  else
    echo "Score is not running."
    return 1
  fi
}

# Writes $2 to $1 atomically with mode $3 (temp file in the same folder, then rename).
write_atomic() {
  local target="$1" content="$2" mode="$3" tmp
  tmp="$(mktemp "$(dirname "$target")/.score-tmp.XXXXXX")"
  printf '%s' "$content" >"$tmp"
  chmod "$mode" "$tmp"
  mv -f "$tmp" "$target"
}

# systemd specifiers: a literal % in a unit file is written %%.
unit_escape() { printf '%s' "${1//%/%%}"; }

# Key names (never values) that differ between two files, for "what changed" without printing secrets.
changed_keys() {
  diff <(cat "$1" 2>/dev/null) <(printf '%s' "$2") | sed -nE 's/^[<>] ([A-Za-z0-9_]+)=.*/\1/p' | sort -u | paste -sd, - || true
}

service_env_content() {
  local name value out="" key
  local -a names=()
  while IFS= read -r name; do
    case "$name" in
      SCORE_HOME | SCORE_SYSTEMD_USER_DIR | SCORE_CONFIG_DIR | SCORE_SYSTEMCTL | SCORE_LOGINCTL) ;;
      SCORE_*) names+=("$name") ;;
    esac
  done < <(compgen -e | LC_ALL=C sort)
  # SCORE_HOME as resolved here, PATH as it is now (systemd has no login shell), then every other SCORE_* variable.
  for key in SCORE_HOME PATH "${names[@]}"; do
    if [[ "$key" == SCORE_HOME ]]; then value="$home"; else value="${!key-}"; fi
    if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
      echo "$key contains a line break; the service environment file can't hold it. Fix the variable and run again." >&2
      return 1
    fi
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    out+="$key=\"$value\""$'\n'
  done
  printf '%s' "$out"
}

service_unit_content() {
  local exec_path
  exec_path="$(unit_escape "$root/scripts/score")"
  [[ "$exec_path" == *" "* ]] && exec_path="\"$exec_path\""
  local env_ref="%h/.config/score/score.env"
  [[ -z "${SCORE_CONFIG_DIR:-}" ]] || env_ref="$(unit_escape "$env_file")"
  cat <<EOT
[Unit]
Description=Score (Hermes team workspace)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=$(unit_escape "$root")
ExecStart=$exec_path run
EnvironmentFile=$env_ref
StandardOutput=append:$(unit_escape "$log_file")
StandardError=append:$(unit_escape "$log_file")
Restart=on-failure
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=default.target
EOT
}

service_install() {
  local env_new unit_new pid offset ino reinstall=0 changed linger
  if [[ ! -f "$root/apps/web/dist/index.html" ]]; then
    echo "Score is not built yet. Run 'pnpm build' in $root first." >&2
    return 1
  fi
  if ! sc show-environment >/dev/null 2>&1; then
    echo "The systemd user manager isn't reachable (systemctl --user failed)." >&2
    echo "Log in through a normal session (or 'loginctl enable-linger $this_user' and reboot), then try again." >&2
    return 1
  fi
  lock_launcher
  if pid="$(stray_pid)"; then
    echo "A Score started by the launcher is running (pid $pid); the service can't run beside it." >&2
    echo "Run 'scripts/score stop' first, then 'scripts/score service install'." >&2
    return 1
  fi
  exec 9>&-
  env_new="$(service_env_content)" || return 1
  env_new+=$'\n'
  unit_new="$(service_unit_content)"$'\n'
  service_installed && reinstall=1
  umask 077
  mkdir -p "$config_dir" "$unit_dir" "$home"
  chmod 700 "$config_dir"
  if [[ "$reinstall" == 1 ]]; then
    if printf '%s' "$env_new" | cmp -s - "$env_file"; then
      echo "Environment file unchanged: $env_file"
    else
      changed="$(changed_keys "$env_file" "$env_new")"
      echo "Environment file updated: $env_file${changed:+ (changed: $changed)}"
    fi
    if printf '%s' "$unit_new" | cmp -s - "$unit_file"; then echo "Unit file unchanged: $unit_file"; else echo "Unit file updated: $unit_file"; fi
  else
    echo "Wrote $env_file (private, mode 600) and $unit_file"
  fi
  write_atomic "$env_file" "$env_new" 600
  write_atomic "$unit_file" "$unit_new" 644
  sc daemon-reload
  touch "$log_file"
  read -r ino offset < <(log_state)
  sc reset-failed score >/dev/null 2>&1 || true
  if [[ "$reinstall" == 1 ]]; then
    sc enable score
    sc restart score
  else
    sc enable --now score
  fi
  linger="$("$loginctl_bin" show-user "$this_user" --property=Linger --value 2>/dev/null || true)"
  if [[ "$linger" != yes ]]; then
    echo "Warning: linger is off, so Score only starts after you log in. To start it at boot without a login, run:" >&2
    echo "  loginctl enable-linger $this_user" >&2
  fi
  wait_ready service "$offset" "$ino"
}

service_status() {
  local linger
  if ! service_installed; then
    echo "Score is not installed as a service (scripts/score service install)."
    return 1
  fi
  echo "Unit:     $unit_file"
  echo "State:    $(sc is-active score 2>/dev/null || true)"
  echo "Enabled:  $(sc is-enabled score 2>/dev/null || true)"
  echo "MainPID:  $(service_pid || echo none)"
  if [[ -s "$url_file" ]]; then echo "URL:      $(<"$url_file")"; else echo "URL:      (not known yet)"; fi
  linger="$("$loginctl_bin" show-user "$this_user" --property=Linger --value 2>/dev/null || true)"
  echo "Linger:   ${linger:-unknown}$([[ "$linger" == yes ]] || echo " (loginctl enable-linger $this_user starts Score at boot without a login)")"
}

service_uninstall() {
  local purge=0
  case "${1:-}" in
    "") ;;
    --purge) purge=1 ;;
    *) usage ;;
  esac
  if service_installed; then
    if ! sc disable --now score; then
      echo "Could not stop and disable the Score service (systemctl --user disable --now score failed)." >&2
      echo "Nothing was removed. Fix the user manager, then run 'scripts/score service uninstall' again." >&2
      return 1
    fi
    mv -f "$unit_file" "$unit_file.removing"
    if ! sc daemon-reload; then
      mv -f "$unit_file.removing" "$unit_file"
      echo "systemctl --user daemon-reload failed; the unit file was put back. Run uninstall again." >&2
      return 1
    fi
    rm -f "$unit_file.removing"
    running_pid >/dev/null || rm -f "$pid_file"
    echo "Removed $unit_file. Score is stopped; 'scripts/score start' runs it from the launcher again."
  else
    echo "The Score service is not installed."
  fi
  if [[ "$purge" == 1 ]]; then
    rm -f "$env_file"
    echo "Removed $env_file."
  elif [[ -f "$env_file" ]]; then
    echo "Kept $env_file (use 'service uninstall --purge' to remove it)."
  fi
}

cmd_service() {
  local sub="${1:-}"
  [[ $# -eq 0 ]] || shift
  case "$sub" in
    install) service_install ;;
    status) service_status ;;
    uninstall) service_uninstall "${1:-}" ;;
    *) usage ;;
  esac
}

cmd_logs() {
  [[ -f "$log_file" ]] || { echo "No log yet: $log_file" >&2; return 1; }
  if [[ "${1:-}" == "-f" ]]; then tail -n 100 -f "$log_file"; else tail -n 100 "$log_file"; fi
}

cmd_pair() {
  local pid i
  if ! pid="$(running_pid)"; then
    echo "Score is not running. Start it with 'score start'." >&2
    return 1
  fi
  rm -f "$pair_file"
  kill -USR2 "$pid"
  for ((i = 0; i < 50; i++)); do
    if [[ -f "$pair_file" ]]; then
      echo "Pair this browser: $(<"$pair_file")"
      rm -f "$pair_file"
      return 0
    fi
    sleep 0.1
  done
  if grep -E 'Pair this browser|Setup guide:' "$log_file" | tail -n 1 | grep -q 'Setup guide:'; then
    echo "Score is only serving the HTTPS setup guide: finish HTTPS setup (scripts/score tls) and restart, then pair." >&2
    return 1
  fi
  echo "Score did not produce a pairing link; see $log_file" >&2
  return 1
}

# Tailscale certificate (Let's Encrypt, for this machine's ts.net name) into $SCORE_HOME/tls/tailscale. Needs Tailscale
# with MagicDNS and HTTPS certificates on, and `sudo tailscale set --operator=$USER` once. Score renews it daily.
cmd_tailscale() {
  command -v tailscale >/dev/null || { echo "Tailscale is not installed." >&2; return 1; }
  local name dir="$home/tls/tailscale"
  name="$(tailscale status --json | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))')"
  [[ "$name" =~ ^[a-z0-9.-]+\.ts\.net$ ]] || { echo "No ts.net name: turn on MagicDNS in the Tailscale admin console." >&2; return 1; }
  umask 077
  mkdir -p "$dir"
  chmod 700 "$dir"
  tailscale cert --cert-file "$dir/$name.crt" --key-file "$dir/$name.key" "$name"
  chmod 600 "$dir/$name.key"
  chmod 644 "$dir/$name.crt"
  echo "Certificate for $name in $dir. Restart Score (it must listen on the Tailscale address too, e.g."
  echo "SCORE_HOST=0.0.0.0 SCORE_REMOTE_ANY=1) and open https://$name:${SCORE_PORT:-8741}/"
}

# Local certificate authority and server certificate for remote (HTTPS-only) mode, kept in $SCORE_HOME/tls.
cmd_tls() {
  local new_ca=0 tls_dir="$home/tls" host_name safe_name san="" entry item ext_file csr
  local -a names=() sans=()
  case "${1:-}" in
    "") ;;
    --new-ca) new_ca=1 ;;
    *) usage ;;
  esac
  command -v openssl >/dev/null || { echo "openssl is required (install the openssl package)." >&2; return 1; }
  umask 077
  mkdir -p "$tls_dir"
  chmod 700 "$tls_dir"
  host_name="$(hostname 2>/dev/null || echo score)"
  safe_name="$(printf '%s' "$host_name" | tr -c 'A-Za-z0-9.-' '-')"

  # Subject alternative names: SCORE_HOST, the hosts of SCORE_PUBLIC_ORIGINS, localhost and 127.0.0.1. Only characters
  # that can occur in a host name or an IP address are accepted; anything else is skipped with a note.
  add_san() {
    local value="$1" kind
    value="${value#[}"
    value="${value%]}"
    [[ -n "$value" && "$value" != "0.0.0.0" && "$value" != "::" ]] || return 0
    if [[ ! "$value" =~ ^[A-Za-z0-9.:-]+$ ]]; then
      echo "Skipping unusable host name: $value" >&2
      return 0
    fi
    if [[ "$value" =~ ^[0-9.]+$ || "$value" == *:* ]]; then kind="IP"; else kind="DNS"; fi
    for item in "${sans[@]:-}"; do [[ "$item" == "$kind:$value" ]] && return 0; done
    sans+=("$kind:$value")
  }
  add_san "${SCORE_HOST:-}"
  IFS=',' read -r -a names <<<"${SCORE_PUBLIC_ORIGINS:-}"
  for entry in "${names[@]:-}"; do
    entry="${entry//[[:space:]]/}"
    entry="${entry#*://}"
    entry="${entry%%/*}"
    if [[ "$entry" == \[* ]]; then entry="${entry%%]*}"; else entry="${entry%%:*}"; fi
    add_san "$entry"
  done
  add_san localhost
  add_san 127.0.0.1
  for item in "${sans[@]}"; do san+="${san:+,}$item"; done

  if [[ "$new_ca" == 1 || ! -f "$tls_dir/ca.key" || ! -f "$tls_dir/ca.crt" ]]; then
    rm -f "$tls_dir/ca.key" "$tls_dir/ca.crt" "$tls_dir/ca.srl"
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -sha256 -days 3650 \
      -keyout "$tls_dir/ca.key" -out "$tls_dir/ca.crt" \
      -subj "/CN=Score local CA ($safe_name)" \
      -addext "basicConstraints=critical,CA:TRUE" \
      -addext "keyUsage=critical,keyCertSign,cRLSign" \
      -addext "subjectKeyIdentifier=hash" 2>/dev/null
    echo "Created a new certificate authority."
  else
    echo "Keeping the existing certificate authority (use --new-ca to replace it)."
  fi
  chmod 600 "$tls_dir/ca.key"

  ext_file="$(mktemp "$tls_dir/ext.XXXXXX")"
  csr="$(mktemp "$tls_dir/csr.XXXXXX")"
  printf '%s\n' "basicConstraints=critical,CA:FALSE" "keyUsage=critical,digitalSignature" \
    "extendedKeyUsage=serverAuth" "subjectAltName=$san" "subjectKeyIdentifier=hash" \
    "authorityKeyIdentifier=keyid" >"$ext_file"
  openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -sha256 \
    -keyout "$tls_dir/server.key" -out "$csr" -subj "/CN=$safe_name" 2>/dev/null
  openssl x509 -req -in "$csr" -CA "$tls_dir/ca.crt" -CAkey "$tls_dir/ca.key" -CAcreateserial \
    -days 825 -sha256 -extfile "$ext_file" -out "$tls_dir/server.crt" 2>/dev/null
  rm -f "$ext_file" "$csr"
  chmod 600 "$tls_dir/server.key"
  chmod 644 "$tls_dir/server.crt" "$tls_dir/ca.crt"

  cat <<EOT
Certificate files in $tls_dir:
  ca.crt       the certificate authority to install on each device (public)
  ca.key       its private key: keep it on this machine only
  server.crt   Score's certificate for: $san
  server.key   its private key

Next steps:
  1. Install ca.crt on every device that opens Score (the setup guide at /setup/https has the steps per platform).
  2. Start Score with SCORE_REMOTE=1 SCORE_HOST=<this machine's address> scripts/score start (restart it if it is
     running). It uses these files automatically and serves https://<address>:8741/.
EOT
}

case "${1:-}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  run) cmd_run ;;
  service) shift; cmd_service "$@" ;;
  status) cmd_status ;;
  logs) shift; cmd_logs "${1:-}" ;;
  pair) cmd_pair ;;
  # Sets or resets the security password that guards pairing management (a forgotten one is reset only here).
  tls) shift; cmd_tls "${1:-}" ;;
  tailscale) cmd_tailscale ;;
  password) SCORE_HOME="$home" exec node "$root/scripts/set-password.mjs" ;;
  # 9.1: the way back to the default look if a theme makes Score hard to use (works with Score stopped).
  look) shift; SCORE_HOME="$home" exec node "$root/scripts/look.mjs" "$@" ;;
  # The only supported way to restore the home (7.5): sets the global admission fence for the next start.
  restore) shift; SCORE_HOME="$home" exec node "$root/scripts/restore.mjs" "$@" ;;
  # 7.7a: tell Score a home at a new path is a moved folder (confirm-move) or a copy (confirm-copy); reset-history starts a
  # new run history when Score is holding all agent work (a copied home, a lost journal).
  installation) shift; SCORE_HOME="$home" exec node "$root/scripts/installation.mjs" "$@" ;;
  *) usage ;;
esac
